APP_ENV=prod
APP_SECRET=__APP_SECRET__
DATABASE_URL="postgresql://__DB_USER__:__DB_PWD__@localhost:5432/__DB_NAME__?serverVersion=15&charset=utf8"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=__JWT_PASSPHRASE__

CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|__DOMAIN__)(:[0-9]+)?$'

LOCK_DSN=redis://:__REDIS_PASSWORD__@127.0.0.1:__PORT_REDIS__
MESSENGER_ASYNC_TRANSPORT_DSN=redis://:__REDIS_PASSWORD__@127.0.0.1:__PORT_REDIS__/messages?lazy=1
MESSENGER_RDAP_LOW_TRANSPORT_DSN=redis://:__REDIS_PASSWORD__@127.0.0.1:__PORT_REDIS__/messages-rdap-low?lazy=1
MESSENGER_RDAP_HIGH_TRANSPORT_DSN=redis://:__REDIS_PASSWORD__@127.0.0.1:__PORT_REDIS__/messages-rdap-high?lazy=1
MESSENGER_CONSUMER_NAME=__APP__

# Mail through the box's Postfix; From must be accepted by the relay
MAILER_DSN=smtp://127.0.0.1:25
MAILER_SENDER_NAME="Domain Watchdog"
MAILER_SENDER_EMAIL=__APP__@__DOMAIN__

REGISTRATION_ENABLED=0
REGISTRATION_VERIFY_EMAIL=0
SSO_AUTO_REDIRECT=false

HTTP_SECURE_COOKIE=true

LIMITED_FEATURES=false
LIMIT_MAX_WATCHLIST=0
LIMIT_MAX_WATCHLIST_DOMAINS=0
LIMIT_MAX_WATCHLIST_WEBHOOKS=0
PUBLIC_RDAP_LOOKUP_ENABLED=false

INFLUXDB_ENABLED=false
