[Unit]
Description=Domain Watchdog scheduler (__APP__)
After=network-online.target __APP__-redis.service
Requires=__APP__-redis.service

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__
Environment=APP_ENV=prod
# Symfony scheduler is not wired in this upstream release; mirror the documented
# deployment cadence (see upstream docker compose: watchlist processed every 5 min)
ExecStart=/bin/sh -c 'while true; do /usr/bin/php__PHP_VERSION__ __INSTALL_DIR__/bin/console app:process-watchlist; sleep 300; done'
Restart=always
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
